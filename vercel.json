{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "styles.css",
      "use": "@vercel/static"
    },
    {
      "src": "script.js", 
      "use": "@vercel/static"
    },
    {
      "src": "music.mp3",
      "use": "@vercel/static"
    },
    {
      "src": "api/classify.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/classify", "dest": "/api/classify.js" },
    { "src": "/styles.css", "dest": "/styles.css" },
    { "src": "/script.js", "dest": "/script.js" },
    { "src": "/music.mp3", "dest": "/music.mp3" },
    { "src": "/", "dest": "/index.html" }
  ]
}
